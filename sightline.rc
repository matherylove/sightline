1 VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEOS 0x4
FILETYPE 0x1
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904E4"
        BEGIN
            VALUE "CompanyName", "Sightline"
            VALUE "FileDescription", "Cliente de YouTube y YouTube Music para Windows XP"
            VALUE "FileVersion", "0.1.0.0"
            VALUE "InternalName", "Sightline"
            VALUE "OriginalFilename", "Sightline.exe"
            VALUE "ProductName", "Sightline"
            VALUE "ProductVersion", "0.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1252
    END
END
